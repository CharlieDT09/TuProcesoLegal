# Tu Proceso Legal — Variables de entorno
# Copia este archivo como database/.env y rellena tus valores.
# NUNCA hagas commit de .env a git.

# ── Supabase ─────────────────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://ufnkedficjjvbgsfazka.supabase.co

# Settings → API → service_role key  (para el script de ingesta — NUNCA al frontend)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Settings → API → anon key  (para Netlify Functions — lectura pública)
SUPABASE_ANON_KEY=your-anon-key-here

# Settings → Database → Connection string → URI  (para setup.js / setup.py)
DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ufnkedficjjvbgsfazka.supabase.co:5432/postgres

# ── OpenAI (embeddings RAG) ───────────────────────────────────────
# platform.openai.com → API Keys
# Modelo usado: text-embedding-3-small ($0.02 / 1M tokens)
OPENAI_API_KEY=sk-...

# ── Poppler (OCR para PDFs escaneados) — opcional ─────────────────
# Solo necesario si Poppler NO está en el PATH del sistema.
# Windows: descomenta y ajusta la ruta después de instalar Poppler.
# POPPLER_PATH=C:\poppler\Library\bin

# ── Netlify (solo referencia — configura en Netlify UI) ──────────
# Site → Environment variables
#   ANTHROPIC_API_KEY  = sk-ant-...
#   OPENAI_API_KEY     = sk-...      (misma key de arriba)
#   SUPABASE_URL       = (igual que arriba)
#   SUPABASE_ANON_KEY  = (igual que arriba)
