# Tu Proceso Legal — Variables de entorno (script de ingesta local)
# Copia este archivo como database/.env y rellena tus valores.
# NUNCA hagas commit de database/.env a git.

# ── Supabase ──────────────────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://TU-PROJECT-ID.supabase.co

# Settings → API → service_role key (SOLO para el script de ingesta — NUNCA al frontend)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Settings → Database → Connection string → URI (Transaction pooler)
DB_URL=postgresql://postgres.TU-PROJECT-ID:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Voyage AI (embeddings RAG) ────────────────────────────────────
# voyage.ai → API Keys
# Modelo: voyage-law-2 (especializado en derecho)
VOYAGE_API_KEY=pa-...

# ── Anthropic (Claude) ────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Poppler (OCR para PDFs escaneados) — opcional ─────────────────
# Solo necesario si Poppler NO está en el PATH del sistema.
# Windows: descomenta y ajusta la ruta después de instalar Poppler.
# POPPLER_PATH=C:\poppler\Library\bin

# ── Nota ──────────────────────────────────────────────────────────
# Las variables de producción (ANTHROPIC_API_KEY, VOYAGE_API_KEY,
# SUPABASE_URL, SUPABASE_ANON_KEY, RESEND_API_KEY) se configuran
# directamente en el dashboard de Vercel — no en este archivo.
